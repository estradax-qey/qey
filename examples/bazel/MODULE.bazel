module(name = "qey_example", version = "0")

bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "qey", version = "0.1.0")

# This example builds against the checkout it lives in. In your own project,
# once qey is in the Bazel Central Registry, the bazel_dep above is enough.
# Until then, pin a release or a commit:
#
#   git_override(
#       module_name = "qey",
#       remote = "https://github.com/estradax-qey/qey.git",
#       tag = "v0.1.0",
#   )
local_path_override(
    module_name = "qey",
    path = "../..",
)
